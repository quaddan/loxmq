# ============================================================================
# Environment template for loxmq — COPY to `.env` and fill in the values.
#
# The `.env` file itself is gitignored (see .gitignore). NEVER commit real
# values to this template.
#
# Typical usage:
#   cp .env.example .env
#   # edit .env with the real values
#   source .env
#   mvn quarkus:dev
#
# Credentials are expected in Base64. To encode:
#   echo -n 'my_password' | base64
# ============================================================================


# ----------------------------------------------------------------------------
# Optional — override the Quarkus profile (dev / staging / prod)
# ----------------------------------------------------------------------------
# QUARKUS_PROFILE=dev


# ----------------------------------------------------------------------------
# Miniserver Loxone credentials
# ----------------------------------------------------------------------------
# Username of the Loxone account the binding uses (must have the
# App + Op-Modes + User-Management permissions if you use the admin surface).
LOXONE_MINISERVER_AUTH_USER=<CHANGE ME>

# Password for the account above.
LOXONE_MINISERVER_AUTH_PASSWORD=<CHANGE ME>


# ----------------------------------------------------------------------------
# MQTT broker credentials (FlashMQ, HiveMQ, Mosquitto, EMQX, ...)
# ----------------------------------------------------------------------------
# MQTT v5 username used by the binding for PUBLISH/SUBSCRIBE.
LOXONE_TRANSPORT_SECURITY_CREDENTIALS_USER=<CHANGE ME>

# MQTT v5 password for the account above.
LOXONE_TRANSPORT_SECURITY_CREDENTIALS_PASSWORD=<CHANGE ME>


# ----------------------------------------------------------------------------
# Runtime overrides — consumed by the binding via Quarkus ${VAR:default}
# ----------------------------------------------------------------------------
# Hostname / IP the binding uses to reach the Loxone Miniserver. Overrides
# the `miniserver.example.com` neutral default baked into the YAML profiles.
MINISERVER_HOST=<CHANGE ME>

# TCP port the binding uses to reach the Loxone Miniserver. Overrides the
# YAML default (443 in staging/prod, 80 in dev).
MINISERVER_PORT=<CHANGE ME>

# Hostname / IP of the MQTT broker (FlashMQ, HiveMQ, Mosquitto, EMQX, ...).
# Overrides the `broker.example.com` neutral default baked into the YAML
# profiles.
MQTT_BROKER_HOST=<CHANGE ME>

# TCP port of the MQTT broker. Overrides the YAML default (8084 for
# wss:// in staging/prod, 8083 for plain ws:// in dev).
MQTT_BROKER_PORT=<CHANGE ME>
